# Free key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Which LLM provider agents/tools.py, rag/explain.py, and agents/chat_agent.py
# default to. "groq" (cloud) works anywhere; "ollama" requires a local
# Ollama server running at localhost:11434 and is for local dev only.
HEMOSMART_LLM_PROVIDER=groq

# Model string for the CrewAI orchestrator's own reasoning LLM
# (agents/crew_agents.py). Any LiteLLM-style "groq/..." model works.
HEMOSMART_CREW_LLM_MODEL=groq/openai/gpt-oss-20b

# Postgres connection string. Defaults to a local database if unset
# (see db/database.py) -- only needs setting explicitly for Neon/prod,
# e.g. postgresql+psycopg://user:pass@host/dbname?sslmode=require
# DATABASE_URL=

# Signs JWT access tokens -- generate your own with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_random_64_char_hex_string

# Credentials for the Admin account auto-created on first startup if no
# Admin exists yet (see backend/services/bootstrap.py). Change the
# password after first login; this default is intentionally weak.
# Note: use a real-looking domain here, not .local/.test/.example --
# those are IANA reserved TLDs and POST /api/auth/register's EmailStr
# validation will reject them (the bootstrap account itself bypasses
# that check, but a rejected TLD is confusing to hit later if reused).
ADMIN_EMAIL=admin@hemosmart.app
ADMIN_PASSWORD=change-me-admin

# Redis connection string. Defaults to a local instance if unset (see
# backend/services/cache.py). Caching degrades gracefully if Redis is
# unreachable -- it's a performance optimization, not a dependency.
# At deployment, point this at Upstash's TCP+TLS endpoint, e.g.
# rediss://default:<password>@<host>:<port>
# REDIS_URL=

# Allowed frontend origin(s), comma-separated -- the deployed Vercel URL,
# e.g. https://hemosmart.vercel.app. Unset means "*" (any origin), which
# is only appropriate for local development.
# CORS_ORIGINS=

# Password given to the demo accounts scripts/seed.py creates for each
# role (manager@/staff@/coordinator@/auditor@hemosmart.app). Set this to
# something private before sharing a deployed URL.
# DEMO_PASSWORD=
